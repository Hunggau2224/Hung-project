@model DemoMVC.Models.SinhVien

@{
    ViewData["Title"] = "Xóa sinh viên";
}

<div class="container mt-4">
    <h2 class="demo-title text-danger">Xóa sinh viên</h2>

    <div class="alert alert-warning">
        Bạn có chắc chắn muốn xóa sinh viên này không?
    </div>

    <div class="card shadow-sm">
        <div class="card-body">

            <dl class="row">

                <dt class="col-sm-3">Mã sinh viên</dt>
                <dd class="col-sm-9">
                    @Model.MaSinhVien
                </dd>

                <dt class="col-sm-3">Họ tên</dt>
                <dd class="col-sm-9">
                    @Model.HoTen
                </dd>

                <dt class="col-sm-3">Email</dt>
                <dd class="col-sm-9">
                    @Model.Email
                </dd>

                <dt class="col-sm-3">Lớp</dt>
                <dd class="col-sm-9">
                    @Model.Lop
                </dd>

                <dt class="col-sm-3">Khoa</dt>
                <dd class="col-sm-9">
                    @(Model.Khoa?.TenKhoa ?? "Chưa phân khoa")
                </dd>

            </dl>

            <form asp-action="DeleteConfirmed"
                  asp-route-id="@Model.Id"
                  method="post">

                <button type="submit"
                        class="btn btn-danger">
                    Xác nhận xóa
                </button>

                <a asp-action="Index"
                   class="btn btn-secondary">
                    Hủy
                </a>

            </form>

        </div>
    </div>
</div>