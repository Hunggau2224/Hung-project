@model DemoMVC.Models.SinhVien

@{
    ViewData["Title"] = "Sửa sinh viên";
}

<div class="container mt-4">
    <h2 class="demo-title">Sửa thông tin sinh viên</h2>

    <div class="card shadow-sm">
        <div class="card-body">
            <form asp-action="Edit" method="post">
                <input type="hidden" asp-for="Id" />
                <div class="mb-3">
                    <label asp-for="MaSinhVien" class="form-label"></label>

                    <input asp-for="MaSinhVien" class="form-control" readonly />

                    <span asp-validation-for="MaSinhVien" class="text-danger"></span>
                </div>

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="HoTen" class="form-label"></label>
                    <input asp-for="HoTen" class="form-control" />
                    <span asp-validation-for="HoTen" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email" class="form-control" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Lop" class="form-label"></label>
                    <input asp-for="Lop" class="form-control" />
                    <span asp-validation-for="Lop" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="KhoaId" class="form-label">Khoa</label>
                    <select asp-for="KhoaId" asp-items="ViewBag.KhoaId" class="form-select">
                        <option value="">-- Chọn khoa --</option>
                    </select>
                    <span asp-validation-for="KhoaId" class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-primary">
                    Lưu thay đổi
                </button>

                <a asp-action="Index" class="btn btn-secondary">
                    Quay lại
                </a>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
