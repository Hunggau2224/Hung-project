
@model DemoMVC.Models.ThongTinViewModel

@{
    ViewData["Title"] = "Nhập thông tin";
}

<div class="container mt-4">
    <h2>Nhập thông tin cá nhân</h2>

    <form asp-controller="Demo"
          asp-action="NhapThongTin"
          method="post">

        <div class="mb-3">
            <label asp-for="HoTen" class="form-label">Họ tên</label>
            <input asp-for="HoTen" class="form-control" required />
        </div>

        <div class="mb-3">
            <label asp-for="Tuoi" class="form-label">Tuổi</label>
            <input asp-for="Tuoi" type="number"
                   class="form-control" min="1" required />
        </div>

        <button type="submit" class="btn btn-primary">
            Gửi thông tin
        </button>
    </form>

    @if (!string.IsNullOrEmpty(Model?.ThongBao))
    {
        <div class="alert alert-success mt-3">
            @Model.ThongBao
        </div>
    }
</div>
